<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_notification" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.notification</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <group string="Notifications &amp; Responsible Managers" name="notification_managers">
                    <field name="notification_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
