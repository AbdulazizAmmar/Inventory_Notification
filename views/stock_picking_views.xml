<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_notification" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.notification</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state'][last()]" position="after">
                <field name="notification_status" widget="badge"
                       decoration-warning="notification_status == 'pending'"
                       decoration-success="notification_status == 'validated'"/>
            </xpath>
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="notification_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
